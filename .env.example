# Copy to .env (gitignored). Compose reads this for postgres/redis;
# the host-run api and worker read DATABASE_URL / REDIS_* directly.
POSTGRES_USER=sbom
POSTGRES_PASSWORD=sbom
POSTGRES_DB=sbom

# Host port 5433 to avoid clashing with any locally installed Postgres.
DATABASE_URL=postgres://sbom:sbom@localhost:5433/sbom
REDIS_HOST=localhost
REDIS_PORT=6379

API_PORT=3001
# Placeholder worker pacing / timeout (ms). Defaults: 3000 / 30 min.
# SCAN_PHASE_DELAY_MS=3000
# SCAN_JOB_TIMEOUT_MS=1800000
